[Unit]
Description=PiVoice AI local llama.cpp server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/vendor/llama.cpp/build/bin/llama-server --model __APP_DIR__/models/qwen3.5-2b-q4_k_m.gguf --alias qwen3.5-2b-q4_k_m --host 127.0.0.1 --port 8081 --ctx-size 2048 --threads 4 --threads-batch 4 --parallel 1 --jinja --flash-attn on
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=20
Nice=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
