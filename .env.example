# Configuration template. Phase 1 reads APP_HOST, APP_PORT and LOG_LEVEL.
# The remaining settings are placeholders for later phases.
# Keep real credentials in an ignored local .env, never in this template.
OPENAI_API_KEY=

AUDIO_MODE=webrtc
APP_HOST=0.0.0.0
APP_PORT=8000

# Candidate engines; selection requires later ARM64 benchmarks.
STT_ENGINE=sherpa
TTS_ENGINE=piper

LOG_LEVEL=INFO
ENABLE_BARGE_IN=true
ENABLE_PARTIAL_TRANSCRIPTS=true
ENABLE_STREAMING_LLM=true
