# Configuration template for the application, local STT and text LLM.
# Keep real credentials in an ignored local .env, never in this template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_TIMEOUT_SECONDS=30
LLM_INSTRUCTIONS=Responda em português brasileiro, de forma natural, concisa e sem Markdown.

AUDIO_MODE=webrtc
APP_HOST=0.0.0.0
APP_PORT=8000
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=

STT_ENGINE=sherpa-whisper
STT_MODEL_DIR=models/sherpa-onnx-whisper-tiny
STT_LANGUAGE=pt
STT_NUM_THREADS=4
STT_MIN_AUDIO_SECONDS=0.5
STT_MAX_AUDIO_SECONDS=30

TTS_ENGINE=sherpa-piper
TTS_MODEL_DIR=models/vits-piper-pt_BR-jeff-medium
TTS_NUM_THREADS=2
TTS_SPEED=1.0
TTS_MAX_TEXT_CHARACTERS=2000

LOG_LEVEL=INFO
ENABLE_BARGE_IN=true
ENABLE_PARTIAL_TRANSCRIPTS=true
