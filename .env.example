# Configuration template for the application, local STT and text LLM.
# Keep real credentials in an ignored local .env, never in this template.
APP_GRACEFUL_SHUTDOWN_SECONDS=5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MODELS=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_TIMEOUT_SECONDS=30
LLM_PROVIDER=openai
LLM_SELECTION_PATH=data/llm-selection.json
ASSISTANT_ENABLED=true
ASSISTANT_STATE_PATH=data/assistant-state.json
VOICE_PIPELINE=chained
PIPELINE_SELECTION_PATH=data/pipeline-selection.json
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_MODELS=gpt-realtime-2.1,gpt-realtime-2.1-mini
REALTIME_VOICE=marin
REALTIME_VOICES=marin,cedar,coral,alloy,ash,ballad,echo,sage,shimmer,verse
REALTIME_TIMEOUT_SECONDS=45
REALTIME_MAX_OUTPUT_TOKENS=2048
REALTIME_TEXT_INPUT_PRICE_PER_MILLION=4.00
REALTIME_TEXT_CACHED_INPUT_PRICE_PER_MILLION=0.40
REALTIME_TEXT_OUTPUT_PRICE_PER_MILLION=24.00
REALTIME_AUDIO_INPUT_PRICE_PER_MILLION=32.00
REALTIME_AUDIO_CACHED_INPUT_PRICE_PER_MILLION=0.40
REALTIME_AUDIO_OUTPUT_PRICE_PER_MILLION=64.00
REALTIME_MINI_TEXT_INPUT_PRICE_PER_MILLION=0.60
REALTIME_MINI_TEXT_CACHED_INPUT_PRICE_PER_MILLION=0.06
REALTIME_MINI_TEXT_OUTPUT_PRICE_PER_MILLION=2.40
REALTIME_MINI_AUDIO_INPUT_PRICE_PER_MILLION=10.00
REALTIME_MINI_AUDIO_CACHED_INPUT_PRICE_PER_MILLION=0.30
REALTIME_MINI_AUDIO_OUTPUT_PRICE_PER_MILLION=20.00
REALTIME_PRICING_DATE=2026-10-05
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=qwen3.5-2b-q4_k_m
LOCAL_LLM_MODELS=qwen3.5-2b-q4_k_m
LOCAL_LLM_MAX_OUTPUT_TOKENS=180
LOCAL_LLM_TIMEOUT_SECONDS=90
LLM_INSTRUCTIONS=Responda em português brasileiro, de forma natural, concisa e sem Markdown.
PROMPT_STATE_PATH=data/prompt-state.json
PROMPT_MAX_CHARACTERS=8000

# Local token history. Update prices when the official OpenAI pricing changes.
USAGE_DB_PATH=data/usage.db
USAGE_PRICING_MODEL=gpt-6-luna
USAGE_INPUT_PRICE_PER_MILLION=0.10
USAGE_CACHED_INPUT_PRICE_PER_MILLION=0.01
USAGE_OUTPUT_PRICE_PER_MILLION=0.50
USAGE_PRICING_DATE=2026-09-26

AUDIO_MODE=webrtc
USB_CAPTURE_DEVICE=plughw:CARD=P10S,DEV=0
USB_PLAYBACK_DEVICE=plughw:CARD=P10S,DEV=0
USB_CAPTURE_PERIOD_FRAMES=512
USB_CAPTURE_RETRY_SECONDS=3
USB_ZERO_STREAM_SECONDS=10
USB_MIXER_CARD=P10S
USB_PLAYBACK_VOLUME_PERCENT=75
USB_CAPTURE_VOLUME_PERCENT=100
USB_ERROR_MESSAGE=Desculpe, não consegui concluir a resposta. Tente novamente.
# Enable only after checking that speaker echo does not retrigger the microphone.
USB_ENABLE_BARGE_IN=false
APP_HOST=0.0.0.0
APP_PORT=8000
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=

STT_ENGINE=sherpa-whisper
STT_MODEL_DIR=models/sherpa-onnx-whisper-small
STT_SMALL_MODEL_DIR=models/sherpa-onnx-whisper-small
STT_TINY_MODEL_DIR=models/sherpa-onnx-whisper-tiny
STT_SELECTION_PATH=data/stt-selection.json
STT_LANGUAGE=pt
STT_NUM_THREADS=3
STT_MODEL_PRECISION=int8
STT_NORMALIZE_AUDIO=true
STT_TARGET_PEAK=0.8
STT_MAX_GAIN=12
STT_MIN_AUDIO_SECONDS=0.5
STT_MAX_AUDIO_SECONDS=30

VAD_ENGINE=sherpa-silero
VAD_MODEL_PATH=models/silero_vad.onnx
VAD_THRESHOLD=0.4
VAD_MIN_SILENCE_SECONDS=1.2
VAD_MIN_SPEECH_SECONDS=0.3
VAD_MAX_SPEECH_SECONDS=30
VAD_NUM_THREADS=1
CONVERSATION_MAX_TURNS=6

TTS_ENGINE=sherpa-piper
TTS_MODEL_DIR=models/vits-piper-pt_BR-jeff-medium
TTS_SELECTION_PATH=data/tts-selection.json
TTS_NUM_THREADS=3
TTS_SPEED=1.0
TTS_MAX_TEXT_CHARACTERS=2000
TTS_CHUNK_CHARACTERS=240

LOG_LEVEL=INFO
ENABLE_BARGE_IN=true
